{
  "name": "pivora",
  "version": "0.5.0",
  "private": true,
  "description": "A local-first open-source analytics and BI studio",
  "license": "MIT",
  "author": "Pivora contributors",
  "repository": "https://github.com/mohui666/pivora",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/split-large-wasm.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:local": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 4173",
    "desktop": "npm run build && npm run desktop:runtime && electron .",
    "desktop:runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:dir": "npm run build && npm run desktop:runtime && electron-builder --win --dir",
    "desktop:dist": "npm run build && npm run desktop:runtime && electron-builder --win --publish never",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "test": "tsx --test lib/*.test.ts",
    "lint": "oxlint app lib desktop scripts components/bi components/ui/badge.tsx components/ui/button.tsx components/ui/input.tsx components/ui/native-select.tsx",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "expr-eval": "^2.0.2",
    "html-to-image": "^1.11.13",
    "hyparquet": "^1.29.2",
    "hyparquet-compressors": "^1.1.1",
    "input-otp": "1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "1.31.0",
    "papaparse": "^5.7.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-grid-layout": "^2.2.4",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "hyparquet-writer": "^0.16.9",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
